<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>DOXBIN // DATABASE</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=VT323&display=swap');
        
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-user-select: none;
            user-select: none;
        }
        
        body {
            background: #0a0a0a;
            height: 100vh;
            overflow: hidden;
            font-family: 'VT323', monospace;
            color: #00ff00;
        }
        
        #terminal {
            padding: 15px;
            height: 100vh;
            overflow-y: auto;
            font-size: 16px;
            line-height: 1.4;
            text-shadow: 0 0 5px #00ff00;
        }
        
        .blink {
            animation: blink 1s infinite;
        }
        
        @keyframes blink {
            0%, 100% { opacity: 1; }
            50% { opacity: 0; }
        }
        
        .red { color: #ff0000; text-shadow: 0 0 5px #ff0000; }
        .yellow { color: #ffff00; text-shadow: 0 0 5px #ffff00; }
        .white { color: #ffffff; text-shadow: 0 0 5px #ffffff; }
        
        .line {
            margin-bottom: 5px;
            opacity: 0;
            animation: fadeIn 0.1s forwards;
        }
        
        @keyframes fadeIn {
            to { opacity: 1; }
        }
        
        .hex-dump {
            color: #008800;
            font-size: 12px;
            margin: 10px 0;
        }
        
        #final-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #000;
            z-index: 999;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 20px;
        }
        
        #final-overlay h1 {
            font-size: 60px;
            color: #ff0066;
            text-shadow: 0 0 20px #ff0066;
            margin-bottom: 20px;
            animation: glitch 2s infinite;
        }
        
        @keyframes glitch {
            0%, 100% { transform: translate(0); }
            20% { transform: translate(-2px, 2px); }
            40% { transform: translate(-2px, -2px); }
            60% { transform: translate(2px, 2px); }
            80% { transform: translate(2px, -2px); }
        }
        
        #final-overlay p {
            font-size: 24px;
            color: #00ffff;
            text-shadow: 0 0 10px #00ffff;
        }
        
        .heart {
            font-size: 100px;
            animation: pulse 1s infinite;
        }
        
        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.2); }
        }
        
        .close-btn {
            margin-top: 40px;
            padding: 15px 40px;
            background: transparent;
            border: 2px solid #ff0066;
            color: #ff0066;
            font-family: 'VT323', monospace;
            font-size: 20px;
            cursor: pointer;
            text-transform: uppercase;
        }
        
        /* Scanline effect */
        body::after {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(
                rgba(18, 16, 16, 0) 50%,
                rgba(0, 0, 0, 0.25) 50%
            );
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 998;
        }
    </style>
</head>
<body>

<div id="terminal"></div>

<div id="final-overlay">
    <div class="heart">❤️</div>
    <h1>TIAMO MOMO</h1>
    <p>você foi hackeada pelo amor da sua vida 💕</p>
    <button class="close-btn" onclick="closeWindow()">[ FECHAR ]</button>
</div>

<script>
    const terminal = document.getElementById('terminal');
    
    const lines = [
        { text: "DOXBIN v2.0 - SECURE CONNECTION ESTABLISHED", class: "white", delay: 100 },
        { text: "Target: [REDACTED]", class: "", delay: 200 },
        { text: "IP: 192.168.0.*** | Location: Brazil", class: "", delay: 300 },
        { text: "----------------------------------------", class: "yellow", delay: 400 },
        { text: "[+] Initializing breach protocol...", class: "", delay: 600 },
        { text: "[+] Bypassing firewall... SUCCESS", class: "", delay: 800 },
        { text: "[+] Accessing personal database...", class: "", delay: 1000 },
        { text: " ", class: "", delay: 1100 },
        { text: ">>> DUMPING DATA <<<", class: "red", delay: 1200 },
        { text: " ", class: "", delay: 1300 },
        { text: "HEX DUMP:", class: "yellow", delay: 1400 },
        { text: "7F 45 4C 46 02 01 01 00 00 00 00 00 00 00 00 00 | .ELF............", class: "hex-dump", delay: 1500 },
        { text: "02 00 3E 00 01 00 00 00 00 10 40 00 00 00 00 00 | ..>.......@.....", class: "hex-dump", delay: 1600 },
        { text: "40 00 00 00 00 00 00 00 00 00 00 00 00 40 00 38 | @............@.8", class: "hex-dump", delay: 1700 },
        { text: " ", class: "", delay: 1800 },
        { text: "[*] Name: [TARGET_ACQUIRED]", class: "", delay: 1900 },
        { text: "[*] Phone: +55 *********", class: "", delay: 2000 },
        { text: "[*] Address: Rua dos Bobos, Nº 0", class: "", delay: 2100 },
        { text: "[*] Status: CUTE AS HELL", class: "red", delay: 2200 },
        { text: " ", class: "", delay: 2300 },
        { text: "[!] CRITICAL ERROR", class: "red", delay: 2400 },
        { text: "[!] UNEXPECTED VARIABLE DETECTED", class: "red", delay: 2500 },
        { text: " ", class: "", delay: 2600 },
        { text: "[*] Analyzing...", class: "yellow", delay: 2800 },
        { text: "[*] Decrypting...", class: "yellow", delay: 3000 },
        { text: "[*] Wait...", class: "yellow", delay: 3200 },
        { text: " ", class: "", delay: 3400 },
        { text: "...", class: "white", delay: 3600 },
        { text: "...", class: "white", delay: 3800 },
        { text: "...", class: "white", delay: 4000 },
    ];
    
    let currentLine = 0;
    
    function addLine(text, className) {
        const div = document.createElement('div');
        div.className = `line ${className}`;
        div.textContent = text;
        terminal.appendChild(div);
        terminal.scrollTop = terminal.scrollHeight;
    }
    
    function typeWriter() {
        if (currentLine < lines.length) {
            const line = lines[currentLine];
            addLine(line.text, line.class);
            currentLine++;
            setTimeout(typeWriter, line.delay - (currentLine > 0 ? lines[currentLine - 1].delay : 0));
        } else {
            setTimeout(showFinal, 1000);
        }
    }
    
    function showFinal() {
        document.getElementById('final-overlay').style.display = 'flex';
        if (navigator.vibrate) {
            navigator.vibrate([100, 50, 100, 50, 200]);
        }
    }
    
    function closeWindow() {
        window.close();
        document.querySelector('#final-overlay p').innerHTML = 'só brincadeira bb 😘<br>fecha o navegador';
    }
    
    // Começa ao tocar (para liberar áudio se quiser adicionar depois)
    document.body.addEventListener('click', () => {
        if (currentLine === 0) typeWriter();
    }, { once: true });
    
    // Auto-start após 1s
    setTimeout(typeWriter, 1000);
</script>

</body>
</html>
